{
    "name": "open-agent-asset-manager",
    "version": "0.1.0-beta.2",
    "private": true,
    "workspaces": [
        "packages/core",
        "packages/shared",
        "packages/adapter/framework",
        "packages/adapter/providers/*",
        "packages/app-server/*",
        "packages/client/*"
    ],
    "description": "A portable library for coding-agent skills, instructions and workflows",
    "license": "Apache-2.0",
    "engines": {
        "node": ">=22.0.0"
    },
    "scripts": {
        "build": "node tests/repository/build-workspaces.mjs",
        "test": "npm run build && node tests/repository/workspace-commands.mjs test",
        "test:arch": "vitest run",
        "test:architecture": "vitest run tests/architecture",
        "test:coverage": "npm run build && node tests/repository/workspace-commands.mjs test:coverage",
        "typecheck:conformance": "tsc -p tests/conformance/tsconfig.json",
        "typecheck": "npm run build && npm run typecheck:conformance && node tests/repository/workspace-commands.mjs typecheck",
        "lint": "biome lint .",
        "check:format": "biome format .",
        "format": "biome format --write .",
        "check:ignore": "node tests/coverage/check-ignore-annotations.mjs",
        "check:desktop-delivery": "node tests/repository/desktop-renderer-delivery.mjs",
        "check:desktop-actual-render": "node tests/repository/desktop-actual-render.mjs",
        "package:desktop": "node tests/repository/desktop-distribution.mjs",
        "package:wsl-resource": "node tests/repository/desktop-distribution.mjs --wsl-resource",
        "release:draft": "node tests/repository/release-draft.mjs",
        "verify": "node tests/repository/verify-public.mjs"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.1",
        "@types/node": "^22.0.0",
        "node-gyp": "12.4.0",
        "typescript": "^5.5.0",
        "vitest": "^2.0.0"
    }
}
