{
    "name": "@oaam/client-desktop",
    "version": "0.1.0",
    "description": "Electron, React, and Vite Desktop client for OAAM",
    "license": "Apache-2.0",
    "type": "commonjs",
    "main": "./dist/main/index.js",
    "types": "./dist/index.d.ts",
    "files": [
        "dist",
        "resources"
    ],
    "scripts": {
        "build": "tsc && vite build && vite build --config vite.preload.config.ts && node ../../../tests/repository/product-release.mjs desktop",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "start": "electron ."
    },
    "dependencies": {
        "@oaam/app-server-bootstrap": "^0.1.0",
        "@oaam/app-server-host": "^0.1.0",
        "@oaam/app-server-protocol": "^0.1.0",
        "@oaam/client-framework": "^0.1.0",
        "@oaam/shared": "^0.1.0",
        "lucide-react": "1.26.0",
        "react": "19.2.7",
        "react-dom": "19.2.7"
    },
    "devDependencies": {
        "@electron/packager": "20.0.3",
        "@electron/rebuild": "4.2.0",
        "@testing-library/react": "16.3.0",
        "@types/node": "^22.0.0",
        "@types/react": "19.2.17",
        "@types/react-dom": "19.2.3",
        "@vitejs/plugin-react": "6.0.3",
        "@vitest/coverage-istanbul": "^2.1.9",
        "electron": "42.7.0",
        "jsdom": "26.1.0",
        "typescript": "^5.5.0",
        "vite": "8.1.5",
        "vitest": "^2.0.0"
    },
    "engines": {
        "node": ">=22.0.0"
    }
}
